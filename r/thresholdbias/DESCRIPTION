Package: thresholdbias
Type: Package
Title: Bias from Adverse-Event Reporting Thresholds
Version: 1.0.0
Authors@R: c(
    person("Marwan", "Alqumbaey", role = c("aut", "cre"),
           email = "marwanalqumbaey@gmail.com",
           comment = c(ORCID = "0009-0004-8688-9556")),
    person("Yousef M.", "Nasher", role = "aut",
